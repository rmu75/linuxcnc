msgid ""
"[VERSA_PROBE_OPTIONS]\n"
"ps_probe_tool = 1\n"
msgstr ""

#. type: Plain text
#: src/gui/qtdragon.adoc:822 src/gui/qtdragon.adoc:1100
#, fuzzy
msgid ""
"`qtversaprobe.enable` (HAL_BIT) measurement enabled or not tool. Reflects "
"screen button state."
msgstr ""
