#. type: delimited block -
#: src/getting-started/getting-linuxcnc.adoc:302
#, fuzzy, no-wrap
msgid ""
"sudo apt-get update\n"
"sudo apt-get dist-upgrade\n"
msgstr ""
"sudo apt-get update\n"
"sudo apt-get dist-upgrade\n"

#. type: Plain text
#: src/getting-started/getting-linuxcnc.adoc:307
