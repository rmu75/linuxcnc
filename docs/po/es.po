#. type: Plain text
#: src/gcode/g-code.adoc:1676 src/gcode/g-code.adoc:1729
#, fuzzy
msgid "'Q' - The subroutine number."
msgstr "'Q':el número de subrutina."

#. type: Plain text
#: src/gcode/g-code.adoc:1677 src/gcode/g-code.adoc:1730
#, fuzzy
msgid "'X' - The starting X position, defaults to the initial position."
msgstr "'X' - La posición X inicial, por defecto es la posición inicial."

#. type: Plain text
#: src/gcode/g-code.adoc:1678 src/gcode/g-code.adoc:1731
#, fuzzy
msgid "'Z' - The starting Z position, defaults to the initial position."
msgstr "'Z' - La posición Z inicial, por defecto es la posición inicial."

#. type: Plain text
#: src/gcode/g-code.adoc:1679
#, fuzzy
msgid "'D' - The starting distance of the profile, defaults to 0."
