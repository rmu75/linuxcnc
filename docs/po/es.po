#. type: Title =
#: src/man/man3/hm2_allocate_bspi_tram.3hm2.adoc:1
#, no-wrap
msgid "hm2_allocate_bspi_tram(3hm2)"
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_allocate_bspi_tram.3hm2.adoc:6
msgid "hm2_allocate_bspi_tram - Allocate the TRAM regions for a BSPI channel"
msgstr ""

#. type: delimited block .
#: src/man/man3/hm2_allocate_bspi_tram.3hm2.adoc:12
#, no-wrap
msgid ""
"#include <hostmot2-serial.h>\n"
"hm2_allocate_bspi_tram(char* name)\n"
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_allocate_bspi_tram.3hm2.adoc:22
#, no-wrap
msgid ""
"*hm2_allocate_bspi_tram* Allocate the TRAM memory for bspi instance\n"
"\"name\". \"name\" is a unique string given to each bspi channel during\n"
"hostmot2 setup. The names of the available channels are printed to\n"
"standard output during the driver loading process and take the form:\n"
"hm2_<board name>.<board index>.bspi.<index>, for example:\n"
"hm2_5i23.0.bspi.0 .\n"
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_allocate_bspi_tram.3hm2.adoc:26
msgid ""
"This function allocates the TRAM memory and sets up the regular data "
"transfers. It should be called only when all the frames have been defined by "
"calls to hm2_tram_add_bspi_frame()."
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_allocate_bspi_tram.3hm2.adoc:31
#: src/man/man3/hm2_bspi_set_read_function.3hm2.adoc:44
#: src/man/man3/hm2_bspi_set_write_function.3hm2.adoc:44
#: src/man/man3/hm2_tram_add_bspi_frame.3hm2.adoc:33
msgid ""
"Call only from realtime init code, not from other realtime code or non-"
"realtime components."
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_allocate_bspi_tram.3hm2.adoc:35
#: src/man/man3/hm2_bspi_set_read_function.3hm2.adoc:48
#: src/man/man3/hm2_bspi_set_write_function.3hm2.adoc:48
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:64
#: src/man/man3/hm2_bspi_write_chan.3hm2.adoc:37
#: src/man/man3/hm2_tram_add_bspi_frame.3hm2.adoc:37
#: src/man/man3/hm2_uart_setup.3hm2.adoc:53
msgid "Returns 0 on success and -1 on failure."
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_allocate_bspi_tram.3hm2.adoc:41
msgid ""
"hm2_bspi_set_read_function(3hm2), hm2_bspi_setup_chan(3hm2), "
"hm2_bspi_set_write_function(3hm2), hm2_bspi_write_chan(3hm2), "
"hm2_tram_add_bspi_frame(3hm2)"
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_allocate_bspi_tram.3hm2.adoc:42
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:71
#: src/man/man3/hm2_bspi_write_chan.3hm2.adoc:44
#: src/man/man3/hm2_tram_add_bspi_frame.3hm2.adoc:44
msgid "See src/hal/drivers mesa_7i65.comp for an example usage."
msgstr ""

#. type: Title =
#: src/man/man3/hm2_bspi_set_read_function.3hm2.adoc:1
#, no-wrap
msgid "hm2_bspi_set_read_function(3hm2)"
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_bspi_set_read_function.3hm2.adoc:7
msgid ""
"hm2_bspi_set_read_function - Register a function to handle the tram write "
"phase of a hostmot2 buffered SPI driver."
msgstr ""

#. type: delimited block .
#: src/man/man3/hm2_bspi_set_read_function.3hm2.adoc:13
#, no-wrap
msgid ""
"#include <hostmot2-serial.h>\n"
"int hm2_bspi_set_read_function(char *name, void *func, void *subdata)\n"
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_bspi_set_read_function.3hm2.adoc:22
#, no-wrap
msgid ""
"*hm2_bspi_set_read_function* registers a function in an external driver\n"
"to be called every time that the main Hostmot2 driver calls the generic\n"
"\"process_tram_read\" function. The names of the available channels are\n"
"printed with rtapi_print_msg during the driver loading process and take\n"
"the form:\n"
msgstr ""

#. type: delimited block _
#: src/man/man3/hm2_bspi_set_read_function.3hm2.adoc:25
msgid "hm2_<board name>.<board index>.bspi.<index>"
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_bspi_set_read_function.3hm2.adoc:28
#: src/man/man3/hm2_bspi_set_write_function.3hm2.adoc:27
msgid "For example hm2_5i23.0.bspi.0."
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_bspi_set_read_function.3hm2.adoc:35
msgid ""
"\"func\" should be a pointer to a function in the sub driver which is to be "
"called to process the results of the BSPI TRAM read phase. The function must "
"take a single argument, a pointer to an individual instance of the internal "
"driver. If defined in comp then the function must *not* use the FUNCTION() "
"convenience macro, and the argument to the function in the definition must "
"*always* be (struct state *inst)."
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_bspi_set_read_function.3hm2.adoc:39
msgid ""
"\"subdata\" is a pointer to the driver instance internal data. In the case "
"of a driver written in comp this will always be \"inst\" in the function "
"call and the call should be anywhere in the EXTRA_SETUP code."
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_bspi_set_read_function.3hm2.adoc:54
msgid ""
"hm2_allocate_bspi_tram(3hm2), hm2_bspi_setup_chan(3hm2), "
"hm2_bspi_set_write_function(3hm2), hm2_bspi_write_chan(3hm2), "
"hm2_tram_add_bspi_frame(3hm2), src/hal/drivers mesa_7i65.comp in the "
"LinuxCNC source distribution."
msgstr ""

#. type: Title =
#: src/man/man3/hm2_bspi_set_write_function.3hm2.adoc:1
#, no-wrap
msgid "hm2_bspi_set_write_function(3hm2)"
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_bspi_set_write_function.3hm2.adoc:7
msgid ""
"hm2_bspi_set_write_function - Register a function to handle the tram write "
"phase of a hostmot2 buffered SPI driver."
msgstr ""

#. type: delimited block -
#: src/man/man3/hm2_bspi_set_write_function.3hm2.adoc:14
#, no-wrap
msgid ""
"#include <hostmot2-serial.h>\n"
"int hm2_bspi_set_write_function(char *name, void *func, void *subdata)\n"
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_bspi_set_write_function.3hm2.adoc:23
#, no-wrap
msgid ""
"*hm2_bspi_set_write_function* registers a function in an external driver\n"
"to be called every time that the main Hostmot2 driver calls the generic\n"
"\"prepare_tram_write\" functions. The names of the available channels are\n"
"printed with rtapi_print_msg during the driver loading process and take\n"
"the form:\n"
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_bspi_set_write_function.3hm2.adoc:25
#, no-wrap
msgid "**hm2_**_<board name>_**.**_<board index>_**.bspi**._<index>_\n"
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_bspi_set_write_function.3hm2.adoc:35
msgid ""
"\"func\" should be a pointer to a function in the sub driver which is to be "
"called to process the pins into BSPI write registers prior to the regular "
"TRAM write phase. The function must take a single argument, a pointer to an "
"individual instance of the internal driver. If defined in comp then the "
"function must *not* use the FUNCTION() convenience macro, and the argument "
"to the function in the definition must *always* be (struct state *inst)."
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_bspi_set_write_function.3hm2.adoc:38
msgid ""
"\"subdata\" is a pointer to the driver instance internal data.  In the case "
"of a driver written in comp this will always be \"inst\" in the function "
"call."
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_bspi_set_write_function.3hm2.adoc:40
msgid ""
"If using comp then the call to this function should be anywhere in the "
"EXTRA_SETUP code."
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_bspi_set_write_function.3hm2.adoc:54
msgid ""
"hm2_allocate_bspi_tram(3hm2), hm2_bspi_set_read_function(3hm2), "
"hm2_bspi_setup_chan(3hm2), hm2_bspi_write_chan(3hm2), "
"hm2_tram_add_bspi_frame(3hm2), src/hal/drivers mesa_7i65.comp in the "
"LinuxCNC source distribution."
msgstr ""

#. type: Title =
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:1
#, no-wrap
msgid "hm2_bspi_setup_chan(3hm2)"
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:6
msgid "hm2_bspi_setup_chan - setup a Hostmot2 bspi channel"
msgstr ""

#. type: delimited block -
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:14
#, no-wrap
msgid ""
"#include <hostmot2-serial.h>\n"
"int hm2_bspi_setup_chan(char* name, int chan, int cs, int bits, float mhz,\n"
"                        int delay, int cpol, int cpha, int noclear, int noecho)\n"
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:20
#, no-wrap
msgid ""
"*hm2_bspi_setup_chan* allows a realtime component to claim and configure\n"
"a BSPI channel on a previously configured hostmot2 board.\n"
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:28
msgid ""
"A unique string given to the BSPI channel during hostmot2 setup. The names "
"of the available channels are printed to standard output during the driver "
"loading process and take the form **hm2_**_board-name_**.**_board-index_**."
"bspi.**_bspi-index_.  For example, the first index on the first hm2_5i23 "
"board would be called `hm2_5i23.0.bspi.0`."
msgstr ""

#. type: Labeled list
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:28
#, fuzzy, no-wrap
msgid "chan"
msgstr "'<chan>'"

#. type: Plain text
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:31
msgid ""
"Channels are numbered 0 to 15. The value on the chip-select lines is set by "
"cs and need not match the channel number."
msgstr ""

#. type: Labeled list
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:31
#, fuzzy, no-wrap
msgid "cs"
msgstr "Arcos"

#. type: Plain text
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:34
msgid ""
"The chip select line(s) to assert when accessing this channel. BSPI supports "
"4 chip select lines, so the valid range for cs is 0-15."
msgstr ""

#. type: Labeled list
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:34
#, no-wrap
msgid "bits"
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:38
msgid ""
"sets the bit-length of the SPI packet. The maximum supported length is 64 "
"bits but this will span two read FIFO entries and will need special handling "
"(values 32 and below require no special handling)."
msgstr ""

#. type: Labeled list
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:38
#, no-wrap
msgid "mhz"
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:43
msgid ""
"sets the chip communication rate. The maximum value for this is half the "
"FPGA base frequency, so for example with a 48 MHz 5I23 the max SPI frequency "
"is 24 MHz. Values in excess of the max supported will be silently rounded "
"down."
msgstr ""

#. type: Labeled list
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:43
#, fuzzy, no-wrap
msgid "delay"
msgstr "timedelay"

#. type: Plain text
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:45
msgid "sets the chip select valid delay (in ns)"
msgstr ""

#. type: Labeled list
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:45
#, no-wrap
msgid "cpha and cpol"
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:47
msgid "Set the clock phase and polarity (according to the device datasheet)."
msgstr ""

#. type: Labeled list
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:47
#, fuzzy, no-wrap
msgid "noclear"
msgstr "`clear()`"

#. type: Plain text
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:50
msgid ""
"Controls whether the frame clear bit is set after the 32 bit buffer "
"transfer.  This parameter should be set to 1 when the frame length is "
"greater than 32 bits and the next data in the FIFO contains the other bits."
msgstr ""

#. type: Labeled list
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:50
#, no-wrap
msgid "noecho"
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:52
msgid "Set to 1 for devices which do not return data (such as DACs)."
msgstr ""

#. type: Labeled list
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:52
#, fuzzy, no-wrap
msgid "samplelate"
msgstr "sampler_base"

#. type: Plain text
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:55
msgid ""
"Set to 1 to sample the received SPI data 1/2 SPI clock later than normal.  "
"This is useful when high clock rates or isolation cause significant delays "
"from clock to received data."
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:60
msgid ""
"Call only from within realtime init/cleanup code or non-realtime components, "
"not from realtime tasks."
msgstr ""

#. type: Plain text
#: src/man/man3/hm2_bspi_setup_chan.3hm2.adoc:70
msgid ""
"hm2_allocate_bspi_tram(3hm2), hm2_bspi_set_read_function(3hm2), "
"hm2_bspi_set_write_function(3hm2), hm2_bspi_write_chan(3hm2), "
"hm2_tram_add_bspi_frame(3hm2)"
msgstr ""

#. type: Title =
