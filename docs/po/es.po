"HALFILE = existing_configuration_halfile_n\n"
"HALFILE = LIB:hookup_moveoff.tcl\n"
msgstr ""
"[HAL]\n"
"HALUI = halui\n"
"MEDIO = existente_configuration_halfile_1\n"
"...\n"
"MEDIO = existente_configuration_halfile_n\n"
"HALFILE = LIB:hookup_moveoff.tcl\n"

