#. type: Title ===
#: src/gui/pyvcp.adoc:393
#, no-wrap
msgid "LEDs"
msgstr ""

#. type: Plain text
#: src/gui/pyvcp.adoc:397
msgid ""
"A LED is used to indicate the status of a 'bit' halpin.  The LED color will "
"be on_color when the halpin is true, and off_color otherwise."
msgstr ""

#. type: Plain text
#: src/gui/pyvcp.adoc:399
msgid "'<led></led>' - makes a round LED"
msgstr ""

#. type: Plain text
#: src/gui/pyvcp.adoc:400
msgid "'<rectled></rectled>' - makes a rectangle LED"
msgstr ""

#. type: Plain text
#: src/gui/pyvcp.adoc:401
msgid ""
"'<halpin>__name__</halpin>' - _name_ of the pin, default is 'led.__n__', "
"where _n_ is an integer that is incremented for each LED."
msgstr ""

#. type: Plain text
#: src/gui/pyvcp.adoc:402
msgid ""
"'<size>__n__</size>' - _n_ is the size of the led in pixels, default is 20."
msgstr ""

#. type: Plain text
#: src/gui/pyvcp.adoc:404
msgid ""
"'<on_color>__color__</on_color>' - sets the color of the LED to _color_ when "
"the pin is true.  Default is 'green'. See section on <<pyvcp:colors,colors>> "
"for more info."
msgstr ""

#. type: Plain text
#: src/gui/pyvcp.adoc:406
msgid ""
"'<off_color>__color__</off_color>' - sets the color of the LED to _color_ "
"when the pin is false. Default is 'red'."
msgstr ""

#. type: Plain text
#: src/gui/pyvcp.adoc:407
msgid "'<height>__n__</height>' - sets the height of the LED in pixels."
msgstr ""

#. type: Plain text
#: src/gui/pyvcp.adoc:408
msgid "'<width>__n__</width>' - sets the width of the LED in pixels."
msgstr ""

#. type: Plain text
#: src/gui/pyvcp.adoc:409
msgid ""
"'<disable_pin>false</disable_pin>' - when true adds a disable pin to the led."
msgstr ""

#. type: Plain text
#: src/gui/pyvcp.adoc:410
msgid ""
"'<disabled_color>__color__</disabled_color>' - sets the color of the LED to "
"_color_ when the pin is disabled."
msgstr ""

