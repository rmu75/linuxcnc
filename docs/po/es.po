#, no-wrap
msgid "7I64"
msgstr ""

#. type: Plain text
#: src/man/man9/sserial.9.adoc:180
msgid ""
"The 7I64 is a 24-input 24-output IO card. 7I64 pins and parameters have "
"names like \"hm2__<BoardType>__.__<BoardNum>__.7i64.__<PortNum>__."
"__<ChanNum>__.__<Pin>__\", for example `hm2_5i23.0.7i64.1.3.output-01`."
msgstr ""

