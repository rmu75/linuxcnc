#. type: Labeled list
#: src/man/man9/hostmot2.9.adoc:1007
#, fuzzy, no-wrap
msgid "offset (float rw)"
msgstr "(float) *value*"

#. type: Plain text
#: src/man/man9/hostmot2.9.adoc:1010
msgid ""
"Sets the per channel pulse width offset in ms. This would be set to 1.5 ms "
"for 1-2 ms servos for a 0 center position."
msgstr ""

#. type: Plain text
#: src/man/man9/hostmot2.9.adoc:1015
msgid ""
"Sets the per channel pulse width scaling. For example, setting the scale to "
"90 and the offset to 1.5 ms would result in a position range of +-45 degrees "
"and scale in degrees for 1-2 ms servos with a full motion range of 90 "
"degrees."
msgstr ""

#. type: Title ===
