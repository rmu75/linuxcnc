"línea."

#. type: delimited block -
#: src/hal/basic-hal.adoc:173
#, fuzzy, no-wrap
msgid ""
"#   signal       destination2\n"
"net xStep => parport.0.pin-06-out\n"
msgstr ""
"#   signal       destination2\n"
"net xStep => parport.0.pin-02-out\n"

#. type: Block title
#: src/hal/basic-hal.adoc:175
#, fuzzy, no-wrap
