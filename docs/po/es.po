#, fuzzy, no-wrap
msgid "*-I button-cfg-file* (see below for file format)"
msgstr "Formato del archivo de configuración"

#. type: Labeled list
#: src/man/man1/xhc-hb04.1.adoc:61
#, no-wrap
msgid "*-H* run in real-time HAL mode (simulation mode is default)"
msgstr ""

#. type: Labeled list
#: src/man/man1/xhc-hb04.1.adoc:62
#, no-wrap
msgid "*-x* wait for pendant detection before creating HAL pins."
msgstr ""

#. type: Labeled list
#: src/man/man1/xhc-hb04.1.adoc:63
#, fuzzy, no-wrap
msgid "*-s *_ n_ _n_ is one of the following stepsize sequences"
msgstr "Un movimiento de roscado rígido consiste en la siguiente secuencia:"

#. type: Plain text
#: src/man/man1/xhc-hb04.1.adoc:67
msgid ""
"1: 1,10,100,1000 (default) 2: 1,5,10,20 3: 1,10,100 4: 1,5,10,20,50,100 5: "
"1,10,50,100,1000 The stepsize selected is always multiplied by 0.001"
msgstr ""

#. type: Title ==
