#, no-wrap
msgid "height"
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:813
#, no-wrap
msgid ""
"Integer\n"
"The height of the widget in pixel.\n"
"Allowed values are 24 to 96.\n"
"Default is 36."
msgstr ""

#. type: Plain text
#: src/gui/gladevcp.adoc:818
#, no-wrap
msgid ""
"Float\n"
"The start value to set.\n"
"Allowed values are in the range from 0.001 to 99999.0.\n"
"Default is 10.0."
msgstr ""

