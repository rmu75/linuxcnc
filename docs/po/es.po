#: src/hal/tutorial.adoc:444
#, fuzzy
msgid "One lists all the pins currently defined in HAL,"
msgstr "One lists all the pins currently defined in HAL,"

#. type: Plain text
#: src/hal/tutorial.adoc:445
#, fuzzy
msgid "one lists all the signals,"
msgstr "One lists all the signals,"

#. type: Plain text
#: src/hal/tutorial.adoc:446
#, fuzzy
