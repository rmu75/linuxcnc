msgid ""
"Square wave if 'enable' is TRUE or unconnected, low if 'enable' is FALSE"
msgstr ""

#. type: TP
#: man/man9/charge_pump.9:33
#, no-wrap
msgid "B<charge-pump.out-2> bit out "
msgstr ""

#. type: Plain text
#: man/man9/charge_pump.9:36
msgid "Square wave at half the frequency of 'out'"
msgstr ""

#. type: TP
#: man/man9/charge_pump.9:36
#, no-wrap
msgid "B<charge-pump.out-4> bit out "
msgstr ""

#. type: Plain text
