#: src/man/man9/hm2_rpspi.9.adoc:91
#, no-wrap
msgid "REALTIME PERFORMANCE OF THE BCM2835-SPI DRIVER"
msgstr ""

#. type: Plain text
#: src/man/man9/hm2_rpspi.9.adoc:94
