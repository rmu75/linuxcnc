#, no-wrap
msgid "HISTOBINS"
msgstr ""

#. type: Plain text
#: man/man9/histobins.9:13
msgid "histobins - histogram bins utility for scripts/hal-histogram"
msgstr ""

#. type: Plain text
#: man/man9/histobins.9:27
#, no-wrap
msgid ""
"Usage:\n"
"  Read availablebins pin for the number of bins available.\n"
"  Set the minvalue, binsize, and nbins pins.\n"
"    Ensure nbins E<lt>= availablebins\n"
"    For nbins = N, the bins are numbered: 0 ... N-1 \n"
"  Iterate:\n"
"    Set index pin to a bin number: 0 E<lt>= index E<lt> nbins.\n"
"    Read check pin and verify that check pin == index pin.\n"
"    Read outputs: binvalue, pextra, nextra pins.\n"
"         (binvalue is count for the indexed bin)\n"
"         (pextra   is count for all inputs E<gt> maxvalue)\n"
"         (nextra   is count for all bins   E<lt> minvalue)\n"
msgstr ""

#. type: Plain text
#: man/man9/histobins.9:47
#, no-wrap
msgid ""
" If index is out of range (index E<lt> 0 or index E<gt> maxbinnumber)\n"
" then binvalue == -1.\n"
" The input-error pin is set when input rules are violated\n"
" and updates cease.\n"
" The reset pin may be used to restart.\n"
