#: src/plasma/qtplasmac.adoc:1717
#, no-wrap
msgid "For Metric:"
msgstr ""

#. type: delimited block -
#: src/plasma/qtplasmac.adoc:1721
#, fuzzy, no-wrap
msgid "G64 P0.1\n"
msgstr "G4 P0.1\n"

