msgid "'M30'"
msgstr "`M30`"

#. type: Plain text
#: src/gcode/o-code.adoc:176
#, fuzzy
msgid ""
"The main program must be terminated with `M02` or `M30` (or `M99`; see "
"below)."
msgstr ""
"El programa principal debe terminarse con `M02` o `M30` (o `M99`; consulte "
