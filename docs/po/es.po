#. type: delimited block -
#: src/common/linux-faq.adoc:22
#, fuzzy, no-wrap
msgid "$ /usr/sbin/lightdm --show-config\n"
msgstr "$ /usr/sbin/lightdm --show-config\n"

#. type: Plain text
#: src/common/linux-faq.adoc:25
#, fuzzy
msgid ""
"Make a note of the absolute path to the configuration file lightdm.conf."
