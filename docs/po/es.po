#: src/man/man9/sserial.9.adoc:194
#, no-wrap
msgid "7i64.0.0.input-NN-not (bit, out)"
msgstr ""

#. type: Plain text
#: src/man/man9/sserial.9.adoc:195
#, fuzzy
