#~ "    -g geometría: WIDTHxHEIGHT + XOFFSET + YOFFSET\n"
#~ "    -m maximizar ventana\n"
#~ "    -f pantalla completa de la ventana\n"
#~ "    -t tema. El valor predeterminado es el tema del sistema\n"
#~ "    -x incrustar en una ventana X11 que no soporta la incrustación.\n"
