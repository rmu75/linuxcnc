#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:898
#, no-wrap
msgid ""
"class ActionButtonTaskMenuFactory(QExtensionFactory):\n"
"    def __init__(self, parent = None):\n"
"        QExtensionFactory.__init__(self, parent)\n"
msgstr ""

#. type: delimited block -
#: src/gui/qtvcp-custom-widgets.adoc:900
#, no-wrap
msgid "    def createExtension(self, obj, iid, parent):\n"
