msgstr "MACHINE = Mi máquina\n"

#. type: Plain text
#: src/config/ini-config.adoc:100
#, fuzzy
msgid ""
"A variable line may be extended to multiple lines with a terminal backslash "
"(\\) character.  A maximum of `MAX_EXTEND_LINES` (==20) are allowed.  There "
"must be no whitespace following the trailing backslash character."
msgstr ""
"Una línea variable puede extenderse a varias líneas con una barra diagonal "
"inversa (\\).  Se permite un máximo de MAX_EXTEND_LINES (== 20). No debe "
"haber espacios en blanco que sigan al carácter de barra invertida final."

#. type: Plain text
#: src/config/ini-config.adoc:102
#, fuzzy
msgid "Section identifiers may not be extended to multiple lines."
msgstr "Los identificadores de sección no pueden extenderse a varias líneas."

