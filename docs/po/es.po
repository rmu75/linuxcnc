"'M8' - activa el refrigerante de inundación. M8 controla el pin iocontrol.0."
"coolant-flood iocontrol.0."

#. type: Plain text
#: src/gcode/m-code.adoc:199
#, fuzzy
msgid "'M9' - turn both M7 and M8 off."
msgstr "'M9' - apaga M7 y M8."

#. type: Plain text
#: src/gcode/m-code.adoc:202
#, fuzzy
