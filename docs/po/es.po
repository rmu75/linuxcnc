#. type: Block title
#: src/gui/pyvcp.adoc:926
#, no-wrap
msgid "Fill"
msgstr ""

#. type: Plain text
#: src/gui/pyvcp.adoc:931
msgid ""
"Container fill are specified with the '<boxfill fill=\"\"/>' tag.  Valid "
"entries are none, x, y and both.  The x fill is a horizontal fill and the y "
"fill is a vertical fill"
msgstr ""

#. type: Labeled list
#: src/gui/pyvcp.adoc:932
#, no-wrap
msgid "`<boxfill fill =\"style\"/>`"
msgstr ""

#. type: Plain text
#: src/gui/pyvcp.adoc:934
msgid ""
"Where 'style' is none, x, y, or both. Default is x for Vbox and y for Hbox."
msgstr ""

#. type: Block title
#: src/gui/pyvcp.adoc:935
#, no-wrap
msgid "Anchor"
msgstr ""

#. type: Plain text
#: src/gui/pyvcp.adoc:941
msgid ""
"Container anchors are specified with the <boxanchor anchor=\"\"/> tag.  The "
"anchor specifies where to position each slave in its parcel.  Valid entries "
"are center, n, s, e, w, for center, north, south, east and west.  "
"Combinations like sw, se, nw and ne are also valid."
msgstr ""

#. type: Labeled list
#: src/gui/pyvcp.adoc:942
#, no-wrap
msgid "`<boxanchor anchor=\"position\"/>`"
msgstr ""

#. type: Plain text
#: src/gui/pyvcp.adoc:944
msgid ""
"Where 'position' is center, n, s, e, w, ne, nw, se or sw. Default is center."
msgstr ""

#. type: Block title
#: src/gui/pyvcp.adoc:945
#, no-wrap
msgid "Expand"
msgstr ""

#. type: Plain text
#: src/gui/pyvcp.adoc:949
msgid ""
"Container expand is specified with the boolean <boxexpand expand=\"\"/> "
"tag.  Valid entries are \"yes\", \"no\"."
msgstr ""

#. type: Labeled list
#: src/gui/pyvcp.adoc:950
#, no-wrap
msgid "`<boxexpand expand=\"boolean\"/>`"
msgstr ""

#. type: Plain text
#: src/gui/pyvcp.adoc:952
msgid "Where 'boolean' is either \"yes\" or \"no\". Default is yes."
msgstr ""

#. type: Block title
#: src/gui/pyvcp.adoc:953
#, no-wrap
msgid "Hbox"
msgstr ""

#. type: Plain text
#: src/gui/pyvcp.adoc:956
msgid ""
"Use an Hbox when you want to stack widgets horizontally next to each other."
msgstr ""

#. type: delimited block -
#: src/gui/pyvcp.adoc:967
#, no-wrap
msgid ""
"<hbox>\n"
"    <relief>RIDGE</relief>\n"
"    <bd>6</bd>\n"
"    <label><text>\"a hbox:\"</text></label>\n"
"    <led></led>\n"
"    <number></number>\n"
"    <bar></bar>\n"
"</hbox>\n"
msgstr ""

#. type: Block title
