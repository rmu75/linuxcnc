#. type: Title ==
#: src/config/python-interface.adoc:56
#, fuzzy, no-wrap
msgid "Reading LinuxCNC status"
msgstr "Lectura del Estado de LinuxCNC"

#. type: Plain text
#: src/config/python-interface.adoc:61
#, fuzzy
msgid ""
"Here is a Python fragment to explore the contents of the `linuxcnc.stat` "
"object which contains some 80+ values (run while linuxcnc is running for "
"typical values):"
msgstr ""
"Aquí hay un fragmento de Python para explorar el contenido del objeto "
"`linuxcnc.stat` que contiene más de 80 valores (correr mientras linuxcnc se "
"está ejecutando para valores típicos):"

#. type: delimited block -
#: src/config/python-interface.adoc:77
#, fuzzy, no-wrap
msgid ""
"#!/usr/bin/env python3\n"
"# -*- coding: utf-8 -*-\n"
"import sys\n"
"import linuxcnc\n"
"try:\n"
"    s = linuxcnc.stat() # create a connection to the status channel\n"
"    s.poll() # get current values\n"
"except linuxcnc.error, detail:\n"
"    print(\"error\", detail)\n"
"    sys.exit(1)\n"
"for x in dir(s):\n"
"    if not x.startswith(\"_\"):\n"
"        print(x, getattr(s,x))\n"
msgstr ""
"#!/usr/bin/env python3\n"
"# -*- coding: utf-8 -*-\n"
"import sys\n"
"import linuxcnc\n"
"try:\n"
"    s = linuxcnc.stat() # crea una conexión al canal de estado\n"
"    s.poll() # obtener valores actuales\n"
"except linuxcnc.error, detail:\n"
"    print \"error\", detail\n"
"    sys.exit(1)\n"
"for x in dir(s):\n"
"    if not x.startswith(\"_\"):\n"
"        print x, getattr(s,x)\n"

