#. type: Title ===
#: src/gui/gstat.adoc:48
#, fuzzy, no-wrap
msgid "Sample HAL component code pattern"
msgstr "Actualizaciones de componentes Hal"

#. type: Plain text
#: src/gui/gstat.adoc:51
msgid "This program creates two HAL pins that output the status of G20/G21."
msgstr ""

#. type: delimited block -
#: src/gui/gstat.adoc:63
#, no-wrap
msgid ""
"import gi\n"
"gi.require_version('Gtk', '3.0')\n"
"from gi.repository import GObject\n"
"from gi.repository import GLib\n"
"import hal\n"
"from hal_glib import GStat\n"
"GSTAT = GStat()\n"
msgstr ""

#. type: delimited block -
#: src/gui/gstat.adoc:68
#, no-wrap
msgid ""
"# callback to change HAL pin state\n"
"def mode_changed(obj, data):\n"
"        h['g20'] = not data\n"
"        h['g21'] = data\n"
msgstr ""

#. type: delimited block -
#: src/gui/gstat.adoc:74
#, fuzzy, no-wrap
msgid ""
"# Make a component and pins\n"
"h = hal.component(\"metric_status\")\n"
"h.newpin(\"g20\", hal.HAL_BIT, hal.HAL_OUT)\n"
"h.newpin(\"g21\", hal.HAL_BIT, hal.HAL_OUT)\n"
"h.ready()\n"
msgstr ""
"mycomp = hal.component('my_component')\n"
"mycomp.newpin('idle-led',hal.HAL_BIT,hal.HAL_IN)\n"
"mycomp.newpin('pause-led',hal.HAL_BIT,hal.HAL_IN)\n"
"mycomp.ready()\n"

#. type: delimited block -
#: src/gui/gstat.adoc:77
#, no-wrap
msgid ""
"# connect a GSTAT message to a callback function\n"
"GSTAT.connect(\"metric-mode-changed\",mode_changed)\n"
msgstr ""

#. type: delimited block -
#: src/gui/gstat.adoc:80
#, no-wrap
msgid ""
"# force GSTAT to initialize states\n"
"GSTAT.forced_update()\n"
msgstr ""

#. type: delimited block -
#: src/gui/gstat.adoc:86
#, no-wrap
msgid ""
"# loop till exit\n"
"try:\n"
"    GLib.MainLoop().run()\n"
"except KeyboardInterrupt:\n"
"    raise SystemExit\n"
msgstr ""

#. type: Plain text
#: src/gui/gstat.adoc:91
#, no-wrap
msgid ""
"This would be loaded with `loadusr python PATH-TO-FILE/FILENAME.py` or if you need to wait for the pins to be made before continuing:\n"
"`loadusr python -Wn metric_status PATH-TO-FILE/FILENAME.py`\n"
"The pins would be: `metric_status.g20` and `metric_status.g21`."
msgstr ""

