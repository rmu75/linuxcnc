#, fuzzy
msgid "One of the quadrature outputs\\&."
msgstr "Estado de la entrada hardware."

#. type: Plain text
#: man/man9/sim_encoder.9:72
msgid "B<sim-encoder\\&.*>I<N>\\&.phase-B* bit out"
msgstr ""

#. type: Plain text
#: man/man9/sim_encoder.9:74
#, fuzzy
msgid "The other quadrature output\\&."
msgstr "Estado de la entrada hardware."

#. type: Plain text
