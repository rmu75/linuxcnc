"  E<lt>u32E<gt> \n"
"      E<lt>halpinE<gt>\"time-hours\"E<lt>/halpinE<gt>\n"
"      E<lt>fontE<gt>(\"Helvetica\",14)E<lt>/fontE<gt>\n"
"      E<lt>formatE<gt>\"2d\"E<lt>/formatE<gt>\n"
"  E<lt>/u32E<gt>\n"
"  E<lt>labelE<gt>\n"
"    E<lt>textE<gt>\":\"E<lt>/textE<gt>\n"
"    E<lt>fontE<gt>(\"Helvetica\",14)E<lt>/fontE<gt>\n"
"  E<lt>/labelE<gt>\n"
"  E<lt>u32E<gt> \n"
"      E<lt>halpinE<gt>\"time-minutes\"E<lt>/halpinE<gt>\n"
"      E<lt>fontE<gt>(\"Helvetica\",14)E<lt>/fontE<gt>\n"
"      E<lt>formatE<gt>\"2d\"E<lt>/formatE<gt>\n"
"  E<lt>/u32E<gt>\n"
"  E<lt>labelE<gt>\n"
"    E<lt>textE<gt>\":\"E<lt>/textE<gt>\n"
