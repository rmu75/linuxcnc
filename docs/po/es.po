#: src/config/moveoff.adoc:110
#, fuzzy
msgid ""
"Disconnect the original joint.N.motor-pos-cmd and joint.N.motor-pos-fb pin "
"connections"
msgstr ""
"Desconectar los pines de conexion joint.N.motor-pos-cmd y joint.N.motor-pos-"
"fb"

#. type: Plain text
#: src/config/moveoff.adoc:112
#, fuzzy
msgid ""
"Load (loadrt) the moveoff component (using the name mv) with a personality "
"set to accommodate all axes identified in the INI file"
msgstr ""
"Cargar (loadrt) el componente moveoff (usando el nombre mv) con una "
"personalidad configurada para acomodar todos los ejes identificados en el "
"archivo ini"

#. type: Plain text
#: src/config/moveoff.adoc:113
#, fuzzy
msgid "Add (addf) the moveoff component functions in the required sequence"
msgstr ""
"Agregar (addf) las funciones del componente moveoff en la secuencia requerida"

#. type: Plain text
#: src/config/moveoff.adoc:115
#, fuzzy
msgid ""
"Reconnect the joint.N.motor-pos-cmd and joint.N.motor-pos-fb pins to use the "
"moveoff component"
msgstr ""
"Volver a conectar los pines joint.N.motor-pos-cmd y joint.N.motor-pos-fb "
