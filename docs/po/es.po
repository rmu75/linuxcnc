"            root_window.tk.call('.pane.top.right','raise','numbers')\n"
"        elif hal.get_value('gladevcp.user0-tab'):\n"
"            root_window.tk.call('.pane.top.right','raise','user_0')\n"
"    except:\n"
"        pass\n"
