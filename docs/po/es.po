msgstr "Registro(((Logging)))"

#. type: Plain text
#: src/gcode/overview.adoc:1057
#, fuzzy
msgid ""
"'(LOGOPEN,filename.txt)' - opens the named log file. If the file already "
"exists, it is truncated."
msgstr ""
"'(LOGOPEN, filename.txt)' - abre el archivo de registro nombrado. Si el "
"archivo ya existe, se trunca."

#. type: Plain text
#: src/gcode/overview.adoc:1059
#, fuzzy
msgid ""
"'(LOGAPPEND,filename)' - opens the named log file. If the file already "
"exists, the data is appended."
msgstr ""
"'(LOGAPPEND, filename)' - abre el archivo de registro nombrado. Si el "
"archivo ya existe, los datos se adjuntan."

#. type: Plain text
#: src/gcode/overview.adoc:1060
#, fuzzy
msgid "'(LOGCLOSE)' - closes an open log file."
msgstr "'(LOGCLOSE)' - cierra un archivo de registro abierto."

#. type: Plain text
#: src/gcode/overview.adoc:1062
#, fuzzy
msgid ""
"'(LOG,)' - everything past the ',' is written to the log file if it is "
"open.  Supports expansion of parameters as described below."
msgstr ""
"'(LOG,)' - todo lo sigue a la ',' se escribe en el archivo de registro si "
"está abierto.  Admite la expansión de parámetros como se describe a "
"continuación."

#. type: Plain text
#: src/gcode/overview.adoc:1065
#, fuzzy
