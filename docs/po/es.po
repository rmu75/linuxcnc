#. type: Plain text
#: src/config/ini-config.adoc:1358
#, fuzzy
msgid ""
"`TOOL_TABLE = tool.tbl` - The file which contains tool information, "
"described in the User Manual."
msgstr ""
"'TOOL_TABLE = tool.tbl' - El archivo que contiene información sobre "
"herramientas, descrito en el manual de usuario."

#. type: Plain text
#: src/config/ini-config.adoc:1360
#, fuzzy
msgid ""
"`DB_PROGRAM = db_program` - Path to an executable program that manages tool "
"data.  When a DB_PROGRAM is specified, a TOOL_TABLE entry is ignored."
msgstr ""
"'DB_PROGRAM = db_program' - Path to an executable program that manages tool "
