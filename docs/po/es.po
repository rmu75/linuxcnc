#. type: Plain text
#: src/gui/qtdragon.adoc:892
msgid "EXTRA DEPTH - distance to lower probe from top of material,"
msgstr ""

#. type: Plain text
#: src/gui/qtdragon.adoc:893
#, no-wrap
