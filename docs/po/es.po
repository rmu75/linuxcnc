#: src/gui/gscreen.adoc:239
#, fuzzy, no-wrap
msgid "Adding Keybindings Functions"
msgstr "Agregar funciones de combinación de teclas"

#. type: Plain text
#: src/gui/gscreen.adoc:244
msgid ""
"Our tester example would be more useful if it responded to keyboard "
"commands.  There is a function called keybindings() that tries to set this "
"up.  While you can override it completely, we didn't - but it assumes some "
"things:"
msgstr ""

#. type: Plain text
#: src/gui/gscreen.adoc:246
msgid ""
"It assumes the estop toggle button is call 'button_estop' and that F1 key "
"controls it."
msgstr ""

#. type: Plain text
#: src/gui/gscreen.adoc:247
msgid ""
"It assumes the power button is called 'button_machine_on' and the F2 key "
"controls it."
msgstr ""

#. type: Plain text
#: src/gui/gscreen.adoc:250
msgid ""
"These are easily fixed by renaming the buttons in the Glade editor to "
"match.  But instead we are going to override the standard calls and add our "
"own."
msgstr ""

#. type: Plain text
#: src/gui/gscreen.adoc:252
#, fuzzy
msgid "Add these command to the handler file:"
msgstr "Agregue estos comandos al archivo de controlador:"

#. type: delimited block -
#: src/gui/gscreen.adoc:271
#, fuzzy, no-wrap
msgid ""
"# override Gscreen Functions\n"
"# keybinding calls\n"
"def on_keycall_ESTOP(self,state,SHIFT,CNTRL,ALT):\n"
"  if state: # only if pressed, not released\n"
"    self.widgets.togglebutton1.emit('activate')\n"
"    self.gscreen.audio.set_sound(self.data.alert_sound)\n"
"    self.gscreen.audio.run()\n"
"    return True # stop progression of signal to other widgets\n"
"def on_keycall_POWER(self,state,SHIFT,CNTRL,ALT):\n"
"  if state:\n"
"    self.widgets.togglebutton2.emit('activate')\n"
"    return True\n"
"def on_keycall_ABORT(self,state,SHIFT,CNTRL,ALT):\n"
"  if state:\n"
"    self.widgets.button3.emit('activate')\n"
"    return True\n"
msgstr ""
"# Ajustar funciones de Gscreen\n"
"# llamadas de combinacion de teclas\n"
"def on_keycall_ESTOP(self,state,SHIFT,CNTRL,ALT):\n"
"  if state: # only if pressed, not released\n"
"    self.widgets.togglebutton1.emit('activate')\n"
"    self.gscreen.audio.set_sound(self.data.alert_sound)\n"
"    self.gscreen.audio.run()\n"
"    return True # stop progression of signal to other widgets\n"
"def on_keycall_POWER(self,state,SHIFT,CNTRL,ALT):\n"
"  if state:\n"
"    self.widgets.togglebutton2.emit('activate')\n"
"    return True\n"
"def on_keycall_ABORT(self,state,SHIFT,CNTRL,ALT):\n"
"  if state:\n"
"    self.widgets.button3.emit('activate')\n"
"    return True\n"

#. type: Plain text
#: src/gui/gscreen.adoc:278
#, fuzzy
msgid ""
